[Unit]
Description=ferrite device agent
Documentation=https://mighty840.github.io/ferrite-sdk/guide/linux-agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ferrite-agent --config /etc/ferrite/agent.conf run
Restart=always
RestartSec=10

# Unprivileged system user from ferrite-agent.sysusers. Not DynamicUser:
# without nss-systemd (Raspbian 10, many minimal images) D-Bus can't resolve
# dynamic UIDs and denies `systemctl show`, which silently drops unit metrics.
# State (boot tracking, offline spool) lives in /var/lib/ferrite-agent.
User=ferrite-agent
Group=ferrite-agent
StateDirectory=ferrite-agent

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=32M

[Install]
WantedBy=multi-user.target
